{
  "name": "xiaoli-control-ios",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@preeternal/react-native-cookie-manager": "^6.4.0",
    "expo": "~57.0.18",
    "expo-linear-gradient": "~57.0.1",
    "expo-secure-store": "~57.0.2",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-webview": "13.16.1"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@types/react": "~19.2.2",
    "tsx": "^4.23.12",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "check": "npm run typecheck && npm test && npm run expo:check",
    "expo:check": "expo install --check && npx --yes expo-doctor@latest",
    "export:ios": "expo export --platform ios --clear",
    "build:preview:ios": "eas build --platform ios --profile preview",
    "build:production:ios": "eas build --platform ios --profile production"
  },
  "private": true
}
