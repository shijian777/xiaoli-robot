{
  "cli": {
    "version": ">= 22.6.0",
    "appVersionSource": "remote"
  },
  "build": {
    "base": {
      "credentialsSource": "remote",
      "ios": {
        "image": "sdk-57"
      }
    },
    "preview": {
      "extends": "base",
      "distribution": "internal",
      "autoIncrement": true
    },
    "production": {
      "extends": "base",
      "distribution": "store",
      "autoIncrement": true
    }
  }
}
