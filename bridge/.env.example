AGENT_STACK_BASE_URL=https://ventured-agent-stack.pingcap.cn
AGENT_STACK_USER_API_KEY=
AGENT_STACK_PROJECT_ID=
MEDIATOR_AGENT_ID=
# Production ASR: configure both Xfyun values. Errors are final and explicit.
XFYUN_RTASR_APP_ID=
XFYUN_RTASR_API_KEY=
# Legacy non-Xfyun mode only: required when both Xfyun values are blank.
ASR_AGENT_ID=
DEVICE_SHARED_TOKEN=
# Optional secure phone-management API. Generate an independent random value
# of at least 32 printable ASCII characters; never reuse a device/cloud key.
MOBILE_ADMIN_TOKEN=
BRIDGE_HOST=0.0.0.0
BRIDGE_PORT=8788
# Set false for a cloud Bridge that does not advertise over local mDNS.
BRIDGE_MDNS_ENABLED=true
# Keep durable case/job state outside the temporary audio directory in production.
BRIDGE_TEMP_DIR=tmp
BRIDGE_STATE_DIR=state
PYTHON_BIN=python
WHISPER_MODEL=small
# Optional: windows on Windows; espeak-ng elsewhere by default. Use xfyun for
# clear cloud Mandarin with a local platform fallback after two failed calls.
TTS_PROVIDER=
# Required together when TTS_PROVIDER=xfyun. Keep these values server-side.
XFYUN_TTS_APP_ID=
XFYUN_TTS_API_KEY=
XFYUN_TTS_API_SECRET=
# Optional Xfyun voice; defaults to x4_xiaoyan.
XFYUN_TTS_VOICE=x4_xiaoyan
# Optional Xfyun voice controls; each is an integer from 0 to 100 and defaults to 50.
XFYUN_TTS_SPEED=50
XFYUN_TTS_VOLUME=50
XFYUN_TTS_PITCH=50
